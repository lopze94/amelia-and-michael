[Unit]
Description=Amelia & Michael wedding site
After=network.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/amelia-and-michael
Environment=PORT=44100
Environment=TRUST_PROXY=1
Environment=DATABASE_FILE=/var/lib/wedding/wedding.sqlite
Environment=TURNSTILE_SITE_KEY=replace-me
Environment=TURNSTILE_SECRET_KEY=replace-me
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
