[Unit]
Description=Amelia & Michael wedding site
After=network.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/amelia-wedding
Environment=PORT=44100
Environment=TRUST_PROXY=1
Environment=DATABASE_FILE=/var/lib/wedding/wedding.sqlite
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
