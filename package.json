{
  "name": "amelia-michael",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && (node scripts/build-css.ts --watch > /dev/null &) ; NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "npm run build:css && (node scripts/build-css.ts --watch > /dev/null &) ; NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "build:css": "node scripts/build-css.ts",
    "prestart": "npm run build:css",
    "pretest": "npm run build:css",
    "pretypecheck": "npm run build:css"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "animejs": "^4.5.0",
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "lightningcss": "^1.33.0",
    "sass": "^1.99.0",
    "typescript": "latest"
  }
}
